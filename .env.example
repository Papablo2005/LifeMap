# archivo: .env.example   ->   copiar a .env y completar. El .env REAL nunca se sube a GitHub.
# Use una contraseña SIN caracteres especiales (@ : / ? #), porque va dentro de una URL.
MONGO_USER=admin
MONGO_PASSWORD=cambiar_esta_clave

# Token de la API de Kaggle (Settings -> API -> Generate New Token; empieza por KGAT_)
KAGGLE_API_TOKEN=

# Opcional: puerto de la API en el equipo (por defecto 5000)
# API_PORT=5000
