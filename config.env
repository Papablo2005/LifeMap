# archivo: config.env  (configuración NO secreta; sí se versiona)

# Dataset que se pide a la API de Kaggle
KAGGLE_DATASET=yelp-dataset/yelp-dataset

# Carpetas dentro de los contenedores (volúmenes "data" y "models")
RAW_DIR=/data/raw
CLEAN_DIR=/data/clean
REPORT_DIR=/data/reportes
MODELS_DIR=/models

# Área y familia reportadas al docente: Saint Louis (MO) + Nightlife
AREA_STATES=MO,IL
# Caja geográfica minLon,minLat,maxLon,maxLat que contiene el área metropolitana (vacío = sin caja)
AREA_BBOX=-90.90,38.30,-89.80,39.10
FAMILIA=Nightlife

# Celda de geohash: 5 caracteres ~ 4,9 x 4,9 km ; 6 caracteres ~ 1,2 x 0,6 km
GEOHASH_PRECISION=5

# Mínimo de días-negocio para comparar tasas (JUSTIFICAR en el informe; ver salida de mapreduce_tasas.py)
MIN_DIAS_NEGOCIO=7447

# Pruebas rápidas: nº de particiones de ~64 MB de reseñas a procesar (vacío = todo el archivo)
MAX_PARTITIONS=

# =========================== ENTREGA 2 ===========================
# Fecha de corte T: las reseñas posteriores a T NO se usan para entrenar; el productor las publica en Kafka.
# Elegir con:  docker compose run --rm ingest python /app/analitica/explorar_t.py   (ver la guía, paso 5)
FECHA_T=2020-01-01
# Versión del modelo de sentimiento (re-entrenado SOLO con reseñas <= T). La prueba de Jenkins la verifica.
SENT_VERSION=2
RIESGO_VERSION=1

# Kafka
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=reviews
# Productor con reloj acelerado: días de reseñas por segundo real (3 = un mes cada 10 s)
VELOCIDAD_DIAS_POR_SEG=3

# Ventanas por geohash: 30 días, watermark 7 días, hotspot si el % negativo sube >= UMBRAL frente a la ventana
# anterior y ambas ventanas tienen >= MIN_RESENAS_VENTANA reseñas (justificar con hotspots_historico.py)
VENTANA_DIAS=30
WATERMARK_DIAS=7
UMBRAL_HOTSPOT=0.15
MIN_RESENAS_VENTANA=10

# Supervivencia (Kaplan-Meier): inicio de la ventana de observación (entrada tardía) y tamaño mínimo de grupo
INICIO_OBSERVACION=2010-01-01
MIN_NEGOCIOS_KM=30
MIN_EVENTOS_KM=10

# Modelo de riesgo de cierre: recall mínimo con el que se elige el umbral de alerta
RECALL_OBJETIVO=0.70
RADIO_COMPETENCIA_M=500
