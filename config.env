# archivo: config.env  (configuración NO secreta; sí se versiona)

# Dataset que se pide a la API de Kaggle
KAGGLE_DATASET=yelp-dataset/yelp-dataset

# Carpetas dentro de los contenedores (volúmenes "data" y "models")
RAW_DIR=/data/raw
CLEAN_DIR=/data/clean
REPORT_DIR=/data/reportes
MODELS_DIR=/models

# Área y familia reportadas al docente: Saint Louis (MO) + Nightlife
AREA_STATES=MO,IL
# Caja geográfica minLon,minLat,maxLon,maxLat que contiene el área metropolitana (vacío = sin caja)
AREA_BBOX=-90.90,38.30,-89.80,39.10
FAMILIA=Nightlife

# Celda de geohash: 5 caracteres ~ 4,9 x 4,9 km ; 6 caracteres ~ 1,2 x 0,6 km
GEOHASH_PRECISION=5

# Mínimo de días-negocio para comparar tasas (JUSTIFICAR en el informe; ver salida de mapreduce_tasas.py)
MIN_DIAS_NEGOCIO=3650

# Pruebas rápidas: nº de particiones de ~64 MB de reseñas a procesar (vacío = todo el archivo)
MAX_PARTITIONS=
